18)Write a query to return the names of restaurants that have at least one review with a rating above the overall average rating of all reviews.
SELECT DISTINCT r.name
FROM Restaurants r
JOIN Reviews v 
    ON r.restaurant_id = v.restaurant_id
WHERE v.rating > (
    SELECT AVG(rating)
    FROM Reviews
);
19).Create a view to list restaurants with a rating greater than 4.

.Write a query that retrieves the user details (user_id and total spending) for users who have spent more than the average spending at high-rated restaurants.

CREATE VIEW high_rated_restaurants AS
SELECT 
    restaurant_id,
    name,
    rating
FROM Restaurants
WHERE rating > 4;
SELECT 
    o.user_id,
    SUM(o.total_price) AS total_spending
FROM Orders o
JOIN high_rated_restaurants hrr
    ON o.restaurant_id = hrr.restaurant_id
GROUP BY o.user_id
HAVING SUM(o.total_price) > (
    SELECT AVG(o2.total_price)
    FROM Orders o2
    JOIN high_rated_restaurants hrr2
        ON o2.restaurant_id = hrr2.restaurant_id
);


